<%- include('partials/header') %>
<div class="panel narrow">
  <h2>เข้าสู่ระบบ</h2>
  <%- include('partials/errors', { errors }) %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>อีเมล <input type="email" name="email" required value="<%= email %>"></label>
    <label>รหัสผ่าน <input type="password" name="password" required></label>
    <button class="btn block">เข้าสู่ระบบ</button>
  </form>
  <p class="muted center">ยังไม่มีบัญชี? <a href="/register">สมัครสมาชิก</a></p>
</div>
<%- include('partials/footer') %>
