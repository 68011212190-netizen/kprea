<%- include('partials/header') %>
<div class="panel narrow">
  <h2>💌 ติดต่อทีมงาน</h2>
  <p class="muted">มีข้อเสนอแนะ หรืออยากให้เพิ่มฟีเจอร์ บอกเราได้เลย</p>
  <%- include('partials/errors', { errors }) %>
  <form method="post" action="/contact">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="two">
      <label>ชื่อ <input name="name" required value="<%= f.name || (user ? user.name : '') %>"></label>
      <label>อีเมล <input type="email" name="email" required value="<%= f.email || (user ? user.email : '') %>"></label>
    </div>
    <label>หัวข้อ <input name="subject" required maxlength="100" value="<%= f.subject || '' %>"></label>
    <label>ข้อความ <textarea name="body" rows="5" required minlength="10" maxlength="1000"><%= f.body || '' %></textarea></label>
    <button class="btn block">ส่งข้อความ</button>
  </form>
</div>
<%- include('partials/footer') %>
