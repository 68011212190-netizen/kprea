<%- include('../partials/header') %>
<h2>ข้อความจากผู้ใช้</h2>
<%- include('nav') %>
<% if (!list.length) { %><div class="empty">ยังไม่มีข้อความ</div><% } %>
<% list.forEach(m => { %>
<div class="panel">
  <div class="row-between"><strong><%= m.subject %></strong><span class="muted"><%= m.created_at.slice(0, 16) %></span></div>
  <p class="muted"><%= m.name %> · <%= m.email %></p>
  <p><%= m.body %></p>
  <form method="post" action="/admin/messages/<%= m.id %>/delete" class="inline" onsubmit="return confirm('ลบข้อความนี้?')">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">ลบ</button>
  </form>
</div>
<% }) %>
<%- include('../partials/footer') %>
